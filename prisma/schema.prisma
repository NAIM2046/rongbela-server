generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String?    @unique
  phone     String?    @unique
  role      Role       @default(CUSTOMER)
  password  String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  addresses Address[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  level       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@index([parentId])
}

enum ProductSellType {
  FIXED_PRICE
  COLLECTIVE
}

model Product {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  description    String?         @db.Text
  specifications Json?
  sellType       ProductSellType @default(FIXED_PRICE)
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images          ProductImage[]
  productVariants ProductVariant[]
  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([createdAt])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  price         Decimal  @default(0.00) @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  attributes    Json
  weight        Float?   @default(0.5)
  length        Float?   @default(10)
  width         Float?   @default(10)
  height        Float?   @default(5)

  version  Int     @default(0)
  isActive Boolean @default(true)

  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
}

model ProductImage {
  id           String  @id @default(uuid())
  url          String
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  createdAt DateTime @default(now())

  @@index([productId])
}

model Banner {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String
  link         String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("banners")
}

model Address {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  recipientName    String   @map("recipient_name")
  phone            String
  alternativePhone String?  @map("alternative_phone")
  streetAddress    String?  @map("street_address")
  postalCode       String?  @map("postal_code")
  exactLocation    String   @map("exact_location")
  isShipping       Boolean  @default(false) @map("is_shipping")
  createdAt        DateTime @default(now()) @map("created_at")

  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id])

  // 🟢 যুক্ত করা হয়েছে: এরিয়া/থানা রিলেশন (ডেলিভারির জন্য সবচেয়ে ইম্পর্ট্যান্ট)
  areaId String? @map("area_id")
  area   Area?   @relation(fields: [areaId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Division {
  id        String     @id @default(uuid())
  name      String
  districts District[]

  @@map("divisions")
}

model District {
  id         String   @id @default(uuid())
  name       String
  isDhaka    Boolean  @default(false) @map("is_dhaka")
  divisionId String   @map("division_id")
  division   Division @relation(fields: [divisionId], references: [id])

  // 🟢 রিলেশন আপডেট
  areas     Area[]
  addresses Address[]

  @@map("districts")
}

// 🟢 নতুন টেবিল: থামা/উপজেলা/এরিয়া (Pathao/Steadfast API-র সাথে সিঙ্ক করতে সুবিধা হবে)
model Area {
  id         String    @id @default(uuid())
  name       String
  districtId String    @map("district_id")
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  addresses  Address[]

  @@map("areas")
}

enum ZoneType {
  SAME_DISTRICT // লোকাল ডেলিভারি (আপনার নিজের জেলার ভেতরে)
  SAME_DIVISION // নিজের বিভাগের অন্য জেলাগুলোতে 
  DHAKA_CITY // ঢাকা সিটি (যেহেতু ই-কমার্সে ঢাকার অর্ডার সবচেয়ে বেশি থাকে)
  CROSS_DIVISION // একদম অন্য বিভাগে (যেমন: চট্টগ্রাম থেকে রংপুর বা খুলনা)
}

// 🟢 অ্যাডমিন শিপিং কনফিগারেশন টেবিল (সহজ ও ডাইনামিক)
model ShippingConfiguration {
  id            String   @id @default(uuid())
  zoneType      ZoneType @unique // জোন অনুযায়ী একটিই রেট কনফিগ থাকবে
  zoneName      String // অ্যাডমিন প্যানেলে দেখানোর জন্য নাম (যেমন: Inside Dhaka)
  baseCharge    Float    @map("base_charge") // প্রাথমিক বা সর্বনিম্ন চার্জ
  baseWeight    Float    @default(1.0) @map("base_weight") // কত কেজি পর্যন্ত বেস চার্জ প্রযোজ্য (যেমন: ১ কেজি)
  extraPerKg    Float    @map("extra_per_kg") // প্রতি অতিরিক্ত কেজির জন্য চার্জ
  codCharge     Float    @default(0.0) @map("cod_charge") // ক্যাশ অন ডেলিভারি পারসেন্টেজ (ঐচ্ছিক, যেমন: 1%)
  estimatedDays String   @map("estimated_days") // ডেলিভারি সময় (যেমন: "2-3 Days")
  isActive      Boolean  @default(true) @map("is_active")

  @@map("shipping_configurations")
}

model Order {
  id              String         @id @default(uuid())
  totalAmount     Float
  orderStatus     OrderStatus    @default(PROCESSING)
  paymentGateway  String
  transactionId   String?        @unique
  shippingAddress Json
  billingAddress  Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orderPayments   OrderPayment[]
  orderItems      OrderItem[]
}

model OrderItem {
  id           String  @id @default(uuid())
  productName  String
  productImage String
  orderId      String
  variant      Json?
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  weightKg     Float?
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderPayment {
  id              String        @id @default(uuid())
  orderId         String
  amount          Float
  gateway         String        @default("SSLCOMMERZ")
  transactionId   String        @unique
  status          PaymentStatus @default(PENDING)
  gatewayResponse Json?
  errorMessage    String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentGateway {
  SSLCOMMERZ
  COD
}
