# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
# We still need Prisma in the builder to compile the TS code
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm prisma generate
RUN pnpm build

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate
WORKDIR /app
ENV NODE_ENV=production

# 1. Copy package files AND the prisma folder
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma

# 2. Install ONLY production dependencies
# This sets up the @prisma/client-runtime-utils correctly in the virtual store
RUN pnpm install --frozen-lockfile --prod

# 3. THE FIX: Re-generate the client in the Runner
# Since all production deps are installed, this command will link 
# the client perfectly to the production runtime utils.
RUN pnpm prisma generate

# 4. Copy ONLY the compiled JS from the builder
COPY --from=builder /app/dist ./dist

EXPOSE 5000

# Start the server directly with node for efficiency
CMD ["node", "dist/server.js"]