# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

# Pin pnpm to exact version
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /app

# Copy package files and prisma schema before install.
# prisma schema must exist before install in case postinstall triggers prisma generate.
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
COPY src/prisma.config.ts ./src/prisma.config.ts

# Install all dependencies including devDependencies (typescript, prisma CLI etc.)
# --frozen-lockfile: fails if lockfile is out of sync. No version drift.
RUN pnpm install --frozen-lockfile

# Generate Prisma client into the fixed path defined in schema.prisma (node_modules/.prisma/client)
# This path is predictable and easy to copy between stages.
RUN pnpm prisma generate

# Copy the rest of the source code
COPY . .

# Compile TypeScript → JavaScript into dist/ folder using tsconfig.json settings
RUN pnpm build


# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM node:24-alpine AS runner

RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /app

ENV NODE_ENV=production

# Copy package files and install production dependencies only.
# --prod: skips devDependencies (no typescript, no prisma CLI etc.)
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
COPY src/prisma.config.ts ./src/prisma.config.ts
RUN pnpm install --frozen-lockfile --prod

# Generate Prisma client in the runner stage too.
# The binary is platform-specific (linux/alpine) so it must be
# generated in the exact environment it will run in.
RUN pnpm prisma generate

# Copy compiled JavaScript from the builder stage.
# Only dist/ is needed — no TypeScript source in production.
COPY --from=builder /app/dist ./dist

EXPOSE 5000

# Runs node dist/server.js via the start script in package.json
CMD ["pnpm", "start"]